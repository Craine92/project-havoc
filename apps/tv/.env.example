# Browser-visible Socket.IO endpoint. Use the PC's LAN hostname/IP for a TV on another device.
VITE_HAVOC_SERVER_URL=http://127.0.0.1:3000

# Future controller entry point used for the visible link and later QR code.
# localhost is not reachable from a separate smartphone.
VITE_PUBLIC_JOIN_URL=http://127.0.0.1:5174/join
