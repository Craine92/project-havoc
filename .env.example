# Bind 0.0.0.0 only when LAN access is wanted.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Required in production; at least 32 bytes. Never commit the real value.
RECONNECT_TOKEN_SECRET=replace-with-at-least-32-random-bytes

MAX_MESSAGE_BYTES=16384
ROOM_CLEANUP_INTERVAL_MS=60000
INACTIVE_ROOM_TTL_MS=21600000
ORPHAN_ROOM_TTL_MS=1800000
CLOSED_ROOM_TTL_MS=300000

CONNECTION_RATE_LIMIT=30
CREATION_RATE_LIMIT=5
JOIN_RATE_LIMIT=20
ACTION_RATE_LIMIT=40
INVALID_MESSAGE_RATE_LIMIT=10
