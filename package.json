{
  "name": "project-havoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspaces --if-present",
    "dev:server": "npm run dev --workspace @project-havoc/server",
    "dev:tv": "npm run dev --workspace @project-havoc/tv --",
    "dev:controller": "npm run dev --workspace @project-havoc/controller --",
    "dev": "npm run dev:lan",
    "dev:lan": "tsx scripts/dev-lan.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:classic-simulation": "tsx scripts/simulate-classic.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "predev:lan": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
