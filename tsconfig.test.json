{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@project-havoc/game-core": ["./packages/game-core/src/index.ts"],
      "@project-havoc/protocol": ["./packages/protocol/src/index.ts"],
      "@project-havoc/test-support": ["./packages/test-support/src/index.ts"]
    }
  },
  "include": ["packages/**/*.test.ts", "apps/**/*.test.ts"]
}
